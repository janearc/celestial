# vim: set filetype=game et ai ts=4 wrap
# celestial: physics, maths, and things that are bigger than you.
name celestial

# the member celestial ships with, beside it as a stack lays it:
# celestial-data, which finds and fetches what the archives hold for
# celestial's tests and for whoever reads the sky with it. it ships as
# its main has it; work lands there first.
stack celestial-data main

lint width 80
lint rows 25
lint comments
lint print
lint exclaim
lint shout
lint words hyperscaler enterprise-grade blazing-fast load-bearing
lint paragraph 4

# lord this is some shouty data, feels like working on oracle back in 2001
# all over again. heckin TSQL feelin caps havin larry smellin stuff btw
# still mad over you guys ending sun microsystems, still mad, ok
lint abbreviations GRAVITY BITPIX PCOUNT GCOUNT BZERO TTYPE
lint abbreviations CFLAGS LDFLAGS CTYPE LONPOLE APOGEE TFORM CDELT
lint abbreviations TNULL TSCAL TUNIT BINTABLE TZERO BSCALE IMAGE

# a property test draws fresh cases every run, so one that passes a
# hundred checks on one machine can fail at the gate on another; game
# runs them harder than go test's hundred
rapid checks 2000

lint allow README.md words paragraph rows
lint allow PACKAGES.md words paragraph rows exclaim
sweep allow README.md emails author
sweep allow doc/hole/README.md emails author

# Binary fixtures can match text-oriented checks by accident. Keep them
# out of linting and distribution.
omit hdf5/testdata
exclude hdf5/testdata

omit fits/testdata
exclude fits/testdata

# Generate test doubles from the interfaces clients use. mockgen is pinned
# as a tool in go.mod so game run mocks uses a reproducible version.
run mocks . :: go tool mockgen -write_package_comment=false -destination mocks/photometry.go -package mocks github.com/janearc/celestial/photometry Photometer
run mocks . :: go tool mockgen -write_package_comment=false -destination mocks/sky.go -package mocks github.com/janearc/celestial/sky Projector
run mocks . :: go tool mockgen -write_package_comment=false -destination mocks/gw.go -package mocks github.com/janearc/celestial/gw Estimator
run mocks . :: go tool mockgen -write_package_comment=false -destination mocks/orbit.go -package mocks github.com/janearc/celestial/orbit Potential
run mocks . :: go tool mockgen -write_package_comment=false -destination mocks/gpu.go -package mocks github.com/janearc/celestial/gpu Device

# Keep cited works available for source verification without distributing
# them. Game can retain files in version control while excluding them
# from dist.
omit cited-sources
exclude cited-sources

# Source-verification work still recorded as outstanding:
#   - GW150914 event JSON and strain files, with their SHA-256 records;
#     the original note placed them in gw/testdata and hdf5/testdata.
#   - Meeus, Astronomical Formulae for Calculators.
#   - The published ISO 21348 standard, which requires purchase.
#   - Peck and Reeder (1972).
#   - Kasten and Young (1989).
#   - Teukolsky (1972).

# Fetch cited works for comparison with recorded values. These copies are
# not for distribution; keep that boundary intact when using this target.
run sources . :: curl -fsSL --retry 3 --retry-all-errors --retry-delay 2 --create-dirs -o cited-sources/codata-2022-g.html https://physics.nist.gov/cgi-bin/cuu/Value?bg
run sources . :: curl -fsSL --retry 3 --retry-all-errors --retry-delay 2 --create-dirs -o cited-sources/codata-2022-alpha.html https://physics.nist.gov/cgi-bin/cuu/Value?alph
