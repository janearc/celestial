# Bodhaine’s symbol font extracts =, +, -, and × as 5, 1, 2, and 3.
# Powers such as 10^-4 become 1024. These patterns retain that extracted
# spelling: "1.034 1 3.17 3 1024" means 1.034 + 3.17 × 10^-4.
# Table 3 similarly extracts E-26 as E226.
run extract . :: pdftotext -layout cited-sources/bodhaine-1999.pdf cited-sources/bodhaine-1999.txt
run extract . :: grep -n -m1 -E On[[:space:]]Rayleigh[[:space:]]Optical[[:space:]]Depth[[:space:]]Calculations cited-sources/bodhaine-1999.txt
run extract . :: grep -n -E ^[[:space:]]+78[.]084[[:space:]]*$ cited-sources/bodhaine-1999.txt
run extract . :: grep -n -E ^O2[[:space:]]+20[.]946 cited-sources/bodhaine-1999.txt
