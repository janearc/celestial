run extract . :: grep -n -A1 -E g0[[:space:]]5[[:space:]]980[.]6160[(]1[[:space:]]2[[:space:]]0[.]002[[:space:]]637[[:space:]]3 cited-sources/bodhaine-1999.txt
run extract . :: grep -n -E 0[.]000[[:space:]]005[[:space:]]9[^(]*[(]11[)] cited-sources/bodhaine-1999.txt
