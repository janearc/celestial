# vim: set filetype=game et ai ts=4 wrap
# celestial: physics and maths and stuff for things that are bigger than you
#
name celestial

lint width 80
lint rows 25
lint comments
lint print
lint exclaim
lint shout
lint words hyperscaler enterprise-grade blazing-fast load-bearing
lint paragraph 4

lint allow README.md words paragraph rows
sweep allow README.md emails author
sweep allow doc/hole/README.md emails author

# this is binary files so sometimes it's going to match whatever
omit hdf5/testdata
exclude hdf5/testdata

# the mocks, generated from the interfaces a caller stands in for in its
# tests. mockgen is pinned in go.mod as a tool, so every run uses the
# same version. game run mocks makes them.
run mocks . :: go tool mockgen -write_package_comment=false -destination mocks/photometry.go -package mocks github.com/janearc/celestial/photometry Photometer
run mocks . :: go tool mockgen -write_package_comment=false -destination mocks/sky.go -package mocks github.com/janearc/celestial/sky Projector
run mocks . :: go tool mockgen -write_package_comment=false -destination mocks/gw.go -package mocks github.com/janearc/celestial/gw Estimator

# game allows us to have items in revision control which are excluded from
# dist. we do this so we can verify the numbers we're using are those which
# are cited in papers
omit cited-sources
exclude cited-sources

# todo:
#   - GW150914's event json and strain file, which are in
#     gw/testdata and hdf5/testdata with their sha256;
#   - meeus's astronomical formulae for calculators, 
#   - the published iso 21348, which is paid
#   - peck and reeder 1972
#   - kasten and young 1989, 
#   - teukolsky 1972

# this is how we verify our numbers against the papers they are pulled from.
# note: i'm not distributing this, i would prefer you be very careful with
# this.
run sources . :: curl -fsSL --retry 3 --retry-all-errors --retry-delay 2 --create-dirs -o cited-sources/codata-2022-g.html https://physics.nist.gov/cgi-bin/cuu/Value?bg
run sources . :: curl -fsSL --retry 3 --retry-all-errors --retry-delay 2 --create-dirs -o cited-sources/codata-2022-alpha.html https://physics.nist.gov/cgi-bin/cuu/Value?alph
run sources . :: curl -fsSL --retry 3 --retry-all-errors --retry-delay 2 --create-dirs -o cited-sources/codata-2022-electron-mev.html https://physics.nist.gov/cgi-bin/cuu/Value?mec2mev
run sources . :: curl -fsSL --retry 3 --retry-all-errors --retry-delay 2 --create-dirs -o cited-sources/codata-2022-proton-mev.html https://physics.nist.gov/cgi-bin/cuu/Value?mpc2mev
run sources . :: curl -fsSL --retry 3 --retry-all-errors --retry-delay 2 --create-dirs -o cited-sources/codata-2022-dalton-mev.html https://physics.nist.gov/cgi-bin/cuu/Value?muc2mev
run sources . :: curl -fsSL --retry 3 --retry-all-errors --retry-delay 2 --create-dirs -o cited-sources/wise-allsky-expsup-iv4h.html https://wise2.ipac.caltech.edu/docs/release/allsky/expsup/sec4_4h.html
run sources . :: curl -fsSL --retry 3 --retry-all-errors --retry-delay 2 --create-dirs -o cited-sources/wise-allsky-expsup-iv4h-table-1.png https://wise2.ipac.caltech.edu/docs/release/allsky/expsup/figures/sec4_4ht1.png
run sources . :: curl -fsSL --retry 3 --retry-all-errors --retry-delay 2 --create-dirs -o cited-sources/mamajek-dwarf-sequence-2022.txt http://www.pas.rochester.edu/~emamajek/EEM_dwarf_UBVIJHK_colors_Teff.txt
run sources . :: curl -fsSL --retry 3 --retry-all-errors --retry-delay 2 --create-dirs -o cited-sources/sereno-de-luca-2006.pdf https://arxiv.org/pdf/astro-ph/0609435
run sources . :: curl -fsSL --retry 3 --retry-all-errors --retry-delay 2 --create-dirs -o cited-sources/iau-2015-b3.pdf https://arxiv.org/pdf/1510.07674
run sources . :: curl -fsSL --retry 3 --retry-all-errors --retry-delay 2 --create-dirs -o cited-sources/usno-circular-179.pdf https://arxiv.org/pdf/astro-ph/0602086
run sources . :: curl -fsSL --retry 3 --retry-all-errors --retry-delay 2 --create-dirs -o cited-sources/planck-2018-vi.pdf https://arxiv.org/pdf/1807.06209
run sources . :: curl -fsSL --retry 3 --retry-all-errors --retry-delay 2 --create-dirs -o cited-sources/bodhaine-1999.pdf https://reef.atmos.colostate.edu/~odell/at721/resources/rayleighOpticalDepth.pdf
run sources . :: curl -fsSL --retry 3 --retry-all-errors --retry-delay 2 --create-dirs -o cited-sources/si-brochure-9.pdf https://www.bipm.org/documents/20126/41483022/SI-Brochure-9-EN.pdf
run sources . :: curl -fsSL --retry 3 --retry-all-errors --retry-delay 2 --create-dirs -o cited-sources/is-gps-200m.pdf https://archive.gps.gov/technical/icwg/IS-GPS-200M.pdf
run sources . :: curl -fsSL --retry 3 --retry-all-errors --retry-delay 2 --create-dirs -o cited-sources/bipm-circular-t-22.pdf https://webtai.bipm.org/ftp/pub/tai/Circular-T/cirtpdf/cirt.22.pdf
run sources . :: curl -fsSL --retry 3 --retry-all-errors --retry-delay 2 --create-dirs -o cited-sources/ligo-discovery-2016.pdf https://arxiv.org/pdf/1602.03837
run sources . :: curl -fsSL --retry 3 --retry-all-errors --retry-delay 2 --create-dirs -o cited-sources/nrao-jansky-90.html https://public.nrao.edu/news/jansky-90-the-origins-of-a-new-window-on-the-universe/
run sources . :: curl -fsSL --retry 3 --retry-all-errors --retry-delay 2 --create-dirs -o cited-sources/iau-2015-resolutions.pdf https://juliaastro.org/UnitfulAstro/stable/assets/IAU2015_English.pdf
run sources . :: curl -fsSL --retry 3 --retry-all-errors --retry-delay 2 --create-dirs -o cited-sources/codata-2018.pdf https://pml.nist.gov/cuu/pdf/RevModPhys.93.025010.pdf
run sources . :: curl -fsSL --retry 3 --retry-all-errors --retry-delay 2 --create-dirs -o cited-sources/moritz-grs80.pdf https://web.archive.org/web/20160220054607/https://geodesy.geology.ohio-state.edu/course/refpapers/00740128.pdf
run sources . :: curl -fsSL --retry 3 --retry-all-errors --retry-delay 2 --create-dirs -o cited-sources/iers-bulletin-c.txt https://hpiers.obspm.fr/iers/bul/bulc/bulletinc.dat
run sources . :: curl -fsSL --retry 3 --retry-all-errors --retry-delay 2 --create-dirs -o cited-sources/iers-utc-tai-history.txt https://hpiers.obspm.fr/iers/bul/bulc/UTC-TAI.history
run sources . :: curl -fsSL --retry 3 --retry-all-errors --retry-delay 2 --create-dirs -o cited-sources/heasarc-fermi.html https://heasarc.gsfc.nasa.gov/docs/heasarc/missions/fermi.html
run sources . :: curl -fsSL --retry 3 --retry-all-errors --retry-delay 2 --create-dirs -o cited-sources/ame-2020.pdf https://amdc.impcas.ac.cn/masstables/Ame2020/Wang_2021_Chinese_Phys._C_45_030003.pdf
run sources . :: curl -fsSL --retry 3 --retry-all-errors --retry-delay 2 --create-dirs -o cited-sources/kerrgeodesic-gw-kerr-spacetime.html https://sagemanifolds.obspm.fr/kerrgeodesic_gw/reference/kerr_spacetime.html

# sonia keys's go implementation of meeus's astronomical algorithms,
# mit licence, at commit bfbd9ac: her tests transcribe his examples with
# their pages. cited, not copied; none of her code is in celestial.
run sources . :: curl -fsSL --retry 3 --retry-all-errors --retry-delay 2 --create-dirs -o cited-sources/soniakeys-meeus-julian-test.go.txt https://raw.githubusercontent.com/soniakeys/meeus/bfbd9ac2c7f709c94f1dee190c633d24a723f628/v3/julian/julian_test.go
run sources . :: curl -fsSL --retry 3 --retry-all-errors --retry-delay 2 --create-dirs -o cited-sources/soniakeys-meeus-sidereal-test.go.txt https://raw.githubusercontent.com/soniakeys/meeus/bfbd9ac2c7f709c94f1dee190c633d24a723f628/v3/sidereal/sidereal_test.go
run sources . :: curl -fsSL --retry 3 --retry-all-errors --retry-delay 2 --create-dirs -o cited-sources/soniakeys-meeus-coord-test.go.txt https://raw.githubusercontent.com/soniakeys/meeus/bfbd9ac2c7f709c94f1dee190c633d24a723f628/v3/coord/coord_test.go

# tobiska and nusinov 2004, iso 21348's authors on its draft
run sources . :: curl -fsSL --retry 3 --retry-all-errors --retry-delay 2 --create-dirs -o cited-sources/tobiska-nusinov-2004.pdf https://spacewx.com/wp-content/uploads/2024/02/P_HEL_ST_2004_C01_0014_04.pdf

# bardeen, press and teukolsky 1972 as ads scans it: its text layer is
# ocr, so its equations are read by eye (pages 349 and 351, pdf 3 and
# 5); extract finds only its title and its horizon, equation 2.6.
run sources . :: curl -fsSL --retry 3 --retry-all-errors --retry-delay 2 --create-dirs -o cited-sources/bardeen-press-teukolsky-1972.pdf https://articles.adsabs.harvard.edu/pdf/1972ApJ...178..347B

# aoki and others 1982, the iau's sidereal time, as ads scans it: three
# pages with no text layer, so equation 14 is read by eye, not extracted.
run sources . :: curl -fsSL --retry 3 --retry-all-errors --retry-delay 2 --create-dirs -o cited-sources/aoki-1982.pdf https://articles.adsabs.harvard.edu/pdf/1982A%26A...105..359A

# us standard atmosphere, 1976, nasa's scanned copy, 18 MB. its text layer
# is noise, so no extract step can read it: tables 2 and 4 are read by
# eye, on pdf pages 18 and 19.
run sources . :: curl -fsSL --retry 3 --retry-all-errors --retry-delay 2 --create-dirs -o cited-sources/us-standard-atmosphere-1976.pdf https://ntrs.nasa.gov/api/citations/19770009539/downloads/19770009539.pdf

# this step takes data we've pulled down and extracts the records to verify
# the numbers/equations used in the code.
#
# wise's zero points are in table 1, an image (the -table-1.png above):
# no step can read it, so it is read by eye against research's wise
# numbers, 309.540, 171.787, 31.674 and 8.363 jy.
run extract . :: grep -n -o -E 6[.]674&nbsp;30&nbsp;x&nbsp;10<sup>-11</sup> cited-sources/codata-2022-g.html
run extract . :: grep -n -o -E Source:[[:space:]]2022[[:space:]]CODATA cited-sources/codata-2022-g.html
run extract . :: grep -n -o -E 7[.]297&nbsp;352&nbsp;5643&nbsp;x&nbsp;10<sup>-3</sup> cited-sources/codata-2022-alpha.html
run extract . :: grep -n -o -E Source:[[:space:]]2022[[:space:]]CODATA cited-sources/codata-2022-alpha.html
run extract . :: grep -n -o -E 0[.]510&nbsp;998&nbsp;950&nbsp;69[[:space:]]+MeV cited-sources/codata-2022-electron-mev.html
run extract . :: grep -n -o -E Source:[[:space:]]2022[[:space:]]CODATA cited-sources/codata-2022-electron-mev.html
run extract . :: grep -n -o -E 938[.]272&nbsp;089&nbsp;43[[:space:]]+MeV cited-sources/codata-2022-proton-mev.html
run extract . :: grep -n -o -E Source:[[:space:]]2022[[:space:]]CODATA cited-sources/codata-2022-proton-mev.html
run extract . :: grep -n -o -E 931[.]494&nbsp;103&nbsp;72[[:space:]]+MeV cited-sources/codata-2022-dalton-mev.html
run extract . :: grep -n -o -E Source:[[:space:]]2022[[:space:]]CODATA cited-sources/codata-2022-dalton-mev.html
run extract . :: grep -n -o -E Table[[:space:]]1[[:space:]]lists[[:space:]]the[[:space:]]zero[[:space:]]magnitude[[:space:]]flux[[:space:]]density cited-sources/wise-allsky-expsup-iv4h.html
run extract . :: grep -n -o -E Version[[:space:]]2022[.]04[.]16 cited-sources/mamajek-dwarf-sequence-2022.txt
run extract . :: grep -n -E ^#?SpT cited-sources/mamajek-dwarf-sequence-2022.txt
