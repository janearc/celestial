# Sonia Keys’s MIT-licensed Go implementation of Meeus, at bfbd9ac.
# Her tests transcribe the examples with page references. Cited, not
# copied: none of her implementation is included in Celestial.
run sources . :: curl -fsSL --retry 3 --retry-all-errors --retry-delay 2 --create-dirs -o cited-sources/soniakeys-meeus-julian-test.go.txt https://raw.githubusercontent.com/soniakeys/meeus/bfbd9ac2c7f709c94f1dee190c633d24a723f628/v3/julian/julian_test.go
run sources . :: curl -fsSL --retry 3 --retry-all-errors --retry-delay 2 --create-dirs -o cited-sources/soniakeys-meeus-sidereal-test.go.txt https://raw.githubusercontent.com/soniakeys/meeus/bfbd9ac2c7f709c94f1dee190c633d24a723f628/v3/sidereal/sidereal_test.go
run sources . :: curl -fsSL --retry 3 --retry-all-errors --retry-delay 2 --create-dirs -o cited-sources/soniakeys-meeus-coord-test.go.txt https://raw.githubusercontent.com/soniakeys/meeus/bfbd9ac2c7f709c94f1dee190c633d24a723f628/v3/coord/coord_test.go

# Tobiska and Nusinov (2004), the ISO 21348 authors describing its draft.
run sources . :: curl -fsSL --retry 3 --retry-all-errors --retry-delay 2 --create-dirs -o cited-sources/tobiska-nusinov-2004.pdf https://spacewx.com/wp-content/uploads/2024/02/P_HEL_ST_2004_C01_0014_04.pdf

# Bardeen, Press, and Teukolsky (1972), scanned by ADS. The text layer is
# OCR; equations were read visually on pages 349 and 351 (PDF pages 3
# and 5). Extraction finds the title and horizon equation 2.6 only.
run sources . :: curl -fsSL --retry 3 --retry-all-errors --retry-delay 2 --create-dirs -o cited-sources/bardeen-press-teukolsky-1972.pdf https://articles.adsabs.harvard.edu/pdf/1972ApJ...178..347B

# Aoki et al. (1982), the IAU sidereal-time definition, scanned by ADS.
# The three-page scan has no text layer; equation 14 was read visually.
run sources . :: curl -fsSL --retry 3 --retry-all-errors --retry-delay 2 --create-dirs -o cited-sources/aoki-1982.pdf https://articles.adsabs.harvard.edu/pdf/1982A%26A...105..359A

# US Standard Atmosphere (1976), NASA’s 18 MB scan. Its text layer is
# unusable; tables 2 and 4 were read visually on PDF pages 18 and 19.
run sources . :: curl -fsSL --retry 3 --retry-all-errors --retry-delay 2 --create-dirs -o cited-sources/us-standard-atmosphere-1976.pdf https://ntrs.nasa.gov/api/citations/19770009539/downloads/19770009539.pdf

# ISO 21348:2007 is sold, not open. A reseller serves the published
# standard's first pages free, and they reach clause 6.5; the lead
# author's company serves the proof, which reaches 6.9.
run sources . :: curl -fsSL --retry 3 --retry-all-errors --retry-delay 2 --create-dirs -o cited-sources/iso-21348-2007.pdf https://cdn.standards.iteh.ai/samples/39911/7088f5099b2343c3810f06b6ca9bc35b/ISO-21348-2007.pdf
run sources . :: curl -fsSL --retry 3 --retry-all-errors --retry-delay 2 --create-dirs -o cited-sources/iso-21348-2007-proof.pdf https://spacewx.com/wp-content/uploads/2024/02/ISO_PRF_21348_e_review-1.pdf

# Extract source records for comparison with the values and equations
# used in code.
#
# WISE zero points are in an image, table 1 (-table-1.png above), rather
# than extractable text. Compare it visually with research values
# 309.540, 171.787, 31.674, and 8.363 Jy.
