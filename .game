# bodhaine's paper sets = + - and x in a symbol font that pdftotext
# writes as 5 1 2 and 3, and a power of ten such as 10^-4 as 1024, so the
# patterns below carry those: "1.034 1 3.17 3 1024" is 1.034 + 3.17 x
# 10^-4. its table 3 writes E-26 as E226.
run extract . :: pdftotext -layout cited-sources/bodhaine-1999.pdf cited-sources/bodhaine-1999.txt
run extract . :: grep -n -m1 -E On[[:space:]]Rayleigh[[:space:]]Optical[[:space:]]Depth[[:space:]]Calculations cited-sources/bodhaine-1999.txt
